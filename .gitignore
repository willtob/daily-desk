# Python
__pycache__/
*.py[cod]
.venv/

# Secrets
.env

# Caches: embeddings (Phase 3), fetched pages and LLM summaries (Phase 9).
# All regenerate themselves; they just cost an API call or a fetch.
.cache/

# Generated digests (Phase 5), the API payload (Phase 6), and the seen store
digests/*.md
digests/*.json
# feedback.jsonl is deliberately NOT ignored. Unlike everything in this file it
# does not regenerate — it is hand-made labelling, one tap at a time, and losing
# it means starting over.
# Cached TTS audio (Phase 8) — regenerates on demand, ~700 KB per article
digests/audio/

# The 15-minute learning store. Binary, so it diffs uselessly and merges not at
# all — but unlike the caches it does NOT regenerate, so it is the one ignored
# file here that would hurt to lose. Back it up if the streak starts mattering.
learn.db
learn.db-wal
learn.db-shm

# The retired ESP32 firmware. The tracked files are gone (see the
# firmware-final tag), but ~85 MB of PlatformIO and simulator build output is
# still sitting on disk, along with firmware/src/wifi_credentials.h, which holds
# a real Wi-Fi password.
#
# That file used to be ignored by firmware/.gitignore — which was itself tracked
# and therefore deleted along with everything else, un-ignoring all of it at
# once. A `git add -A` immediately afterwards staged 1389 build artifacts and
# the credentials. This line is what stops that recurring for as long as the
# directory remains on disk.
firmware/

# macOS
.DS_Store

# R console history. Nothing here is an R project; these appear because a
# console was opened in a directory to look at something, and R writes one on
# exit whether or not you asked. Unanchored, so it matches at any depth.
.Rhistory
