# Copy to .env and fill in your keys.

# ── Embedding provider: OpenAI text-embedding-3-small (Phase 3, not needed for Phase 1) ──
# OPENAI_API_KEY=sk-...

# ── Model overrides (optional; both default to the value in the code) ──
# ESP_NEWS_SUMMARY_MODEL=gpt-5.4-mini
# Grading is harder than summarizing — reach for a larger model here first if
# the 15-minute feedback reads as shallow.
# ESP_NEWS_LEARN_MODEL=gpt-5.4-mini

# ── LangSmith tracing (https://smith.langchain.com/settings) ──
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_your_key_here
LANGSMITH_PROJECT=esp-news-reporter
