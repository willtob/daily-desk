<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>ESP News</string>
    <key>CFBundleDisplayName</key>
    <string>ESP News</string>
    <key>CFBundleIdentifier</key>
    <string>com.willtobin.esp-news-widget</string>
    <key>CFBundleExecutable</key>
    <string>ESPNewsWidget</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>

    <!-- No Dock icon, no app-switcher entry. The delegate also sets
         .accessory at launch; this makes it true from the first frame,
         which stops a Dock icon flashing during startup. -->
    <key>LSUIElement</key>
    <true/>

    <key>NSHighResolutionCapable</key>
    <true/>

    <!-- The backend is plain HTTP on loopback or the LAN. App Transport
         Security blocks that by default; this exemption covers exactly
         localhost, *.local and LAN addresses, and nothing on the internet. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
</dict>
</plist>
