<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>ESP News</string>
    <key>CFBundleDisplayName</key>
    <string>ESP News</string>
    <key>CFBundleIdentifier</key>
    <string>com.willtobin.esp-news-widget</string>
    <key>CFBundleExecutable</key>
    <string>ESPNewsWidget</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>

    <!-- No Dock icon, no app-switcher entry. The delegate also sets
         .accessory at launch; this makes it true from the first frame,
         which stops a Dock icon flashing during startup. -->
    <key>LSUIElement</key>
    <true/>

    <key>NSHighResolutionCapable</key>
    <true/>

    <!-- The Learn tab's explain screen is a recorder: you talk about the
         drawn topic and the transcript is what gets graded. These strings
         are mandatory rather than advisory — a process that reaches for
         the microphone without NSMicrophoneUsageDescription is killed by
         the system rather than denied. That is also why `make dev` (swift
         run, no bundle, therefore no Info.plist) cannot exercise this
         screen at all, and `make run` or `make reload` has to be used.

         Transcription is SpeechAnalyzer / SpeechTranscriber, which runs
         against a model installed on this machine. Nothing spoken here
         leaves it — not even to the backend, which is only ever handed
         the finished text, exactly as if it had been typed. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>ESP News records your spoken explanation on the Learn tab so it can be graded.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>ESP News transcribes your spoken explanation on this Mac so it can be graded.</string>

    <!-- The backend is plain HTTP on loopback or the LAN. App Transport
         Security blocks that by default; this exemption covers exactly
         localhost, *.local and LAN addresses, and nothing on the internet. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
</dict>
</plist>
